# Producción (Ibero). Copiar a .env en el servidor y llenar los valores.
# Generar secretos con:  openssl rand -hex 32

# --- Dominios -------------------------------------------------------------
# Dirección pública de la app (sin "/" al final).
NEXT_PUBLIC_BASE_URL=https://tablero.ejemplo.org
# Dirección pública del almacenamiento de imágenes. El navegador sube los
# archivos directo aquí, por eso necesita su propio dominio con HTTPS.
S3_ENDPOINT=https://archivos-tablero.ejemplo.org
NEXT_PUBLIC_STORAGE_URL=https://archivos-tablero.ejemplo.org

# --- Secretos (cambiar TODOS) ---------------------------------------------
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=kanstorage
S3_SECRET_ACCESS_KEY=

# --- Almacenamiento --------------------------------------------------------
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_AVATAR_BUCKET_NAME=kan-avatars
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=kan-attachments
NEXT_API_BODY_SIZE_LIMIT=50mb

# --- Cuentas ----------------------------------------------------------------
NEXT_PUBLIC_ALLOW_CREDENTIALS=true
NEXT_PUBLIC_DISABLE_SIGN_UP=false

# --- Correo (opcional) -----------------------------------------------------
# Sin SMTP, dejar NEXT_PUBLIC_DISABLE_EMAIL=true (no habrá recuperación de
# contraseña por correo ni invitaciones por email).
NEXT_PUBLIC_DISABLE_EMAIL=true
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Tablero Ibero <no-reply@ejemplo.org>"

# --- Marca -----------------------------------------------------------------
NEXT_PUBLIC_WHITE_LABEL_HIDE_POWERED_BY=true

# --- Puertos ---------------------------------------------------------------
# Con dominio: 127.0.0.1 (solo Nginx los ve). Sin dominio todavía: 0.0.0.0 para
# entrar por http://IP:puerto; en ese caso las URLs de arriba son
# http://IP:KAN_WEB_PORT y http://IP:KAN_S3_PORT (sin HTTPS: solo temporal).
KAN_BIND=127.0.0.1
KAN_WEB_PORT=3100
KAN_S3_PORT=9100
